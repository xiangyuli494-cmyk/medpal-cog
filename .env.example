# 复制为 .env 后按需填；不要把真实 Key 提交进仓库

# ---- MCP 服务 ----
MCP_TRANSPORT=streamable-http     # stdio | streamable-http
MCP_PORT=8090
MEDPAL_DB=mcp-server/data/medpal.db

# ---- 模型通道（tools/probe_llm.py 用）----
DASHSCOPE_API_KEY=

# ---- Nexent 接入 ----
NEXENT_BASE_URL=http://127.0.0.1:3000
KB_ENDPOINT=

# ---- 回环必须绕过系统代理，否则 httpx 报 502 ----
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
